{
  "expo": {
    "name": "gus-portal",
    "slug": "gus-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/app-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/app-icon/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ggdl96dev.gusportal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/app-icon.png",
        "backgroundColor": "#F8F9F7"
      },
      "package": "com.ggdl96dev.gusportal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/app-icon/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/spectral/Spectral-Regular.ttf",
            "./assets/fonts/spectral/Spectral-Light.ttf",
            "./assets/fonts/spectral/Spectral-ExtraBold.ttf",
            "./assets/fonts/spectral/Spectral-Medium.ttf",
            "./assets/fonts/spectral/Spectral-SemiBold.ttf",
            "./assets/fonts/spectral/Spectral-LightItalic.ttf",
            "./assets/fonts/spectral/Spectral-ExtraBoldItalic.ttf",
            "./assets/fonts/spectral/Spectral-MediumItalic.ttf",
            "./assets/fonts/spectral/Spectral-SemiBoldItalic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "eslintConfig": {
      "extends": "universe/native"
    }
  }
}
